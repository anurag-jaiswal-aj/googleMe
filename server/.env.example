PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gfolio?retryWrites=true&w=majority
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin auth ────────────────────────────────────────────────────────────────
# Generate hash:  node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── GitHub integration ────────────────────────────────────────────────────────
GITHUB_USERNAME=your-github-username
# Optional PAT for higher rate limits (5000/hr vs 60/hr unauthenticated)
# Needs only: public_repo read scope
GITHUB_TOKEN=

# ── Email — Resend (preferred) ────────────────────────────────────────────────
# Sign up at https://resend.com — free tier is 3000 emails/month
RESEND_API_KEY=
# Must be a verified domain in your Resend account
RESEND_FROM=Portfolio <noreply@yourdomain.com>

# ── Email — SMTP fallback (Gmail) ─────────────────────────────────────────────
# Use an App Password, NOT your real Gmail password
# https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=your_gmail@gmail.com

# ── Cloudinary — image CDN ────────────────────────────────────────────────────
# Dashboard → Settings → API Keys  (free tier at cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
