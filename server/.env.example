PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gfolio?retryWrites=true&w=majority
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin authentication
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate secret: node -e "require('crypto').randomBytes(48).toString('hex')" | node -p "require('fs').readFileSync('/dev/stdin','utf8')"
JWT_SECRET=

# GitHub integration (for live repo sync on Projects page)
GITHUB_USERNAME=anurag-jaiswal-aj
# Optional: Personal Access Token for higher rate limits (5000/hr vs 60/hr unauthenticated)
# Create one at https://github.com/settings/tokens — only needs public_repo read scope
GITHUB_TOKEN=

# Nodemailer (Gmail example — use an App Password, not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=your_gmail@gmail.com

# Cloudinary — image CDN (free tier at cloudinary.com)
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
